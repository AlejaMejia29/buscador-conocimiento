# Copiar como app/.env y completar. Nunca subir app/.env al repositorio.

# Modelo generativo (Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Supabase: corpus del RAG e historial de conversaciones
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Corpus cargado con el notebook final (ver README, "Preparar el corpus")
CORPUS_ID=buscador_conocimiento-29dccc23ac01
CORPUS_PROPIETARIO_ID=
EMBEDDINGS_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42

# Servidor web
GRADIO_SERVER_NAME=127.0.0.1
PORT=7860
GRADIO_SHARE=0

# 1 muestra la casilla para simular la caída del servidor MCP (prueba de falla controlada)
MODO_PRUEBAS=0

# completa (por defecto): MiniLM + reranker con PyTorch, opción C (unos 2 GB de memoria).
# ligera: mismo MiniLM en ONNX cuantizado y sin reranker, opción B (para Render gratis, 512 MB).
RECUPERACION=completa
